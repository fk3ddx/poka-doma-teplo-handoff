# Unity's serializer emits an intentional trailing space for empty YAML values.
unity-game/** text=auto eol=lf
unity-game/**/*.png -text
unity-game/**/*.meta whitespace=-blank-at-eol
unity-game/**/*.asset whitespace=-blank-at-eol
unity-game/**/*.unity whitespace=-blank-at-eol
unity-game/**/*.mat whitespace=-blank-at-eol

unity-game/**/*.jpg -text
unity-game/**/*.wav -text
unity-game/**/*.exr -text
unity-game/**/*.blend -text
unity-game/**/*.fbx -text

*.md text eol=lf
QA/**/*.txt text eol=lf
QA/**/*.json text eol=lf
QA/**/*.xml text eol=lf
Screenshots/**/*.txt text eol=lf
Screenshots/**/*.json text eol=lf
art-sources/Audio/**/*.ogg -text
art-sources/Audio/**/License.txt -text
art-sources/Audio/**/License.txt whitespace=-blank-at-eol,-blank-at-eof
